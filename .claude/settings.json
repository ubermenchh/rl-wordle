{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(ruff check *)",
      "Bash(ty check *)",
      "Bash(uv run *)",
      "Bash(./check.sh)",

      "Edit(/tests/**)",
      "Edit(/check.sh)",
      "Edit(/pyproject.toml)",
      "Edit(/.gitignore)",
      "Edit(/.jarvis/**)",
      "Edit(/results/**)",
      "Edit(/modal_app.py)",
      "Edit(/.github/**)",
      "Write(/tests/**)",
      "Write(/check.sh)",
      "Write(/.jarvis/**)",
      "Write(/results/**)",
      "Write(/modal_app.py)",
      "Write(/.github/**)",
      "Edit(/sft/gen_traces.py)",
      "Write(/sft/gen_traces.py)",
      "Edit(/data/**)",
      "Write(/data/**)",
    ],
    "deny": [
      "Edit(/wordle.py)",
      "Edit(/render.py)",
      "Edit(/reward.py)",
      "Edit(/evaluate.py)",
      "Edit(/gate.py)",
      "Edit(/constrained.py)",
      "Edit(/rl/**)",
      "Write(/wordle.py)",
      "Write(/render.py)",
      "Write(/reward.py)",
      "Write(/evaluate.py)",
      "Write(/gate.py)",
      "Write(/constrained.py)",
      "Write(/rl/**)",
      "Edit(/answers.txt)",
      "Write(/answers.txt)",
      "Edit(/sft/teacher.py)",
      "Write(/sft/teacher.py)",
      "Edit(/sft/train_sft.py)",
      "Write(/sft/train_sft.py)",
      "NotebookEdit(**)",

      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(sed -i *)",
      "Bash(tee *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(ruff format *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(uv sync *)"
    ]
  }
}
